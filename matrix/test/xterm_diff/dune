; Differential tools against xterm. Not tests: they need xterm and an X
; server, which CI lacks, so nothing runs them under @runtest. See README.md.

(executable
 (name xterm_diff)
 (modules xterm_diff gen minimize norm screen vte_adapter xterm)
 (libraries unix matrix.vte matrix.input matrix.grid matrix.ansi matrix.text))

(executable
 (name input_diff)
 (modules input_diff)
 (libraries unix matrix))
