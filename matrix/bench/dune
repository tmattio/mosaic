(executable
 (name bench_ansi)
 (modules bench_ansi)
 (libraries thumper matrix.ansi))

(executable
 (name bench_text)
 (modules bench_text)
 (libraries thumper matrix.text))

(executable
 (name bench_input)
 (modules bench_input)
 (libraries thumper matrix.input))

(executable
 (name bench_grid)
 (modules bench_grid)
 (libraries thumper matrix.grid matrix.ansi))

(executable
 (name bench_screen)
 (modules bench_screen)
 (libraries thumper matrix.screen matrix.grid matrix.ansi))

(executable
 (name bench_runtime)
 (modules bench_runtime)
 (libraries thumper matrix))

(rule
 (alias bench)
 (action
  (progn
   (run %{exe:bench_ansi.exe} --ci -q)
   (diff? ansi.thumper ansi.thumper.corrected)
   (run %{exe:bench_text.exe} --ci -q)
   (diff? text.thumper text.thumper.corrected)
   (run %{exe:bench_input.exe} --ci -q)
   (diff? input.thumper input.thumper.corrected)
   (run %{exe:bench_grid.exe} --ci -q)
   (diff? grid.thumper grid.thumper.corrected)
   (run %{exe:bench_screen.exe} --ci -q)
   (diff? screen.thumper screen.thumper.corrected)
   (run %{exe:bench_runtime.exe} --ci -q)
   (diff? runtime.thumper runtime.thumper.corrected))))
