(** X11's color names and their colors, from X.Org's rgb.txt, which
    {!Reply.rgb_of_spec} reads. x11_colors.ml is generated by
    matrix/support/gen_x11_colors.ml and names the release of rgb.txt it holds.
*)

val names : string array
(** [names] is the color names, lowercased and without spaces, in increasing
    order of [String.compare] and each once. *)

val rgb : int array
(** [rgb.(i)] is the color [names.(i)] names, as [0xRRGGBB]. *)
