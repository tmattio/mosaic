; The demo renders with SDL. Where tsdl or tsdl-ttf is not installed, a
; stub that says so takes its place, so the rest of the tree builds
; without SDL.

(executable
 (name main)
 (public_name matrix)
 (package matrix-term)
 (modules main)
 (libraries
  matrix.ansi
  matrix.input
  matrix.pty
  matrix.vte
  matrix.grid
  matrix.text
  unix
  (select
   main.ml
   from
   (tsdl tsdl-ttf -> main.sdl.ml)
   (-> main.stub.ml))))
