(executable
 (name bench_renderer)
 (modules bench_renderer)
 (libraries thumper mosaic.ui toffee))

(rule
 (alias bench)
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_renderer.exe} --wait-quiet 60)
   (diff? renderer.thumper renderer.thumper.corrected))))

