; The metrics come from /proc on Linux and from Mach and IOKit on macOS; the
; stubs need POSIX headers, so the panel builds only on Unix.

(library
 (name sysstat)
 (modules sysstat)
 (enabled_if
  (= %{os_type} Unix))
 (libraries unix str)
 (foreign_stubs
  (language c)
  (flags
   (:standard
    (:include c_flags.sexp)))
  (names sysstat_stubs))
 (c_library_flags
  (:include c_library_flags.sexp)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (enabled_if
  (= %{os_type} Unix))
 (action
  (run %{exe:config/discover.exe})))

(executable
 (name main)
 (modules main)
 (enabled_if
  (= %{os_type} Unix))
 (libraries mosaic matrix.charts matrix.grid matrix.ansi sysstat unix))
