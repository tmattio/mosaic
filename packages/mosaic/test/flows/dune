; Two of mentat's flows as tests of a chat application in its shape: a
; streamed turn in a session, and the real program's goodbye in a
; pseudo-terminal.

(env
 (_
  (env-vars
   (WINDTRAP_TIMEOUT 60))))

(library
 (name chat)
 (modules chat)
 (libraries mosaic matrix))

(executable
 (name chat_main)
 (modules chat_main)
 (libraries chat mosaic threads.posix))

(library
 (name mosaic_flows)
 (modules test_flows)
 (inline_tests
  (deps chat_main.exe))
 (libraries
  windtrap
  chat
  mosaic
  mosaic.test
  matrix
  matrix.test
  matrix.vte
  unix)
 (preprocess
  (pps ppx_windtrap)))
