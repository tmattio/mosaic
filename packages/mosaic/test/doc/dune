; Typecheck the OCaml snippets of doc/highlighting.md, so the guide's recipe
; cannot drift from the API. The tree-sitter grammars are stubbed by their
; parsing interface; mosaic does not depend on them.

(executable
 (name extract)
 (modules extract))

(rule
 (target highlighting.ml)
 (deps
  (:guide ../../../../doc/highlighting.md))
 (action
  (with-stdout-to
   %{target}
   (run ./extract.exe %{guide} doc/highlighting.md))))

(test
 (name test_highlighting_doc)
 (modules
  test_highlighting_doc
  highlighting
  doc_prelude
  tree_sitter
  tree_sitter_ocaml
  tree_sitter_json)
 (package mosaic)
 (libraries mosaic))
