; Typecheck the OCaml snippets of the repository's README and of mosaic's,
; so that they cannot drift from the API. The snippets are a library that
; nothing links, so building it checks them and runs none of their programs.

(library
 (name mosaic_readmes)
 (modules doc_prelude readme_top readme_mosaic)
 (libraries mosaic mosaic.ui toffee))

(rule
 (target readme_top.ml)
 (deps
  (:readme ../../../../../README.md))
 (action
  (with-stdout-to
   %{target}
   (run ../extract.exe %{readme} README.md))))

(rule
 (target readme_mosaic.ml)
 (deps
  (:readme ../../../README.md))
 (action
  (with-stdout-to
   %{target}
   (run ../extract.exe %{readme} packages/mosaic/README.md))))

(rule
 (alias runtest)
 (package mosaic)
 (deps %{cma:mosaic_readmes})
 (action (progn)))
