(library
 (instrumentation
  (backend ppx_windtrap.coverage))
 ; No (instrumentation (backend ppx_windtrap.mutate)) here: the mutate
 ; backend's arithmetic operator breaks OCaml's type-directed record
 ; disambiguation, so this file stops compiling under it. See
 ; toffee_compute_flexbox.ml:941 (`child.padding.left +. ...`),
 ; where `child.padding` resolves only from the annotated field
 ; earlier in the same expression. Coverage instrumentation is
 ; unaffected and stays.
 (name toffee_compute_flexbox)
 (public_name toffee.compute.flexbox)
 (libraries toffee.geometry toffee.style toffee.tree toffee.compute.helpers))
