;; Allocation counts follow the profile: dev compiles with -opaque, so a dev
;; build would be judged against counts measured in release.

(rule
 (alias bench)
 (enabled_if
  (<> %{profile} release))
 (action
  (system
   "echo 'benchmarks measure release builds: dune build --profile release @bench' >&2; exit 1")))

(executable
 (name bench_toffee)
 (libraries toffee thumper))

(rule
 (alias bench)
 (enabled_if
  (= %{profile} release))
 (deps
  (env_var THUMPER_MACHINE))
 (locks /bench)
 (action
  (progn
   (run %{exe:bench_toffee.exe} --wait-quiet 60)
   (diff? toffee.thumper toffee.thumper.corrected))))
