; The examples that run a program from another event loop, run in a
; pseudo-terminal. Those whose event loop is not installed are skipped, and
; all of them on Windows, which has no pseudo-terminal (see pty.mli).

(executable
 (name test_examples)
 (libraries windtrap matrix.pty unix))

(rule
 (alias runtest)
 (package mosaic)
 (enabled_if
  (and
   (= %{os_type} Unix)
   %{lib-available:eio_main}))
 (action
  (setenv
   EXAMPLE
   %{dep:../../examples/24-eio/main.exe}
   (setenv
    TITLE
    "Async Tasks"
    (setenv
     CANCEL
     1
     (run %{exe:test_examples.exe}))))))

(rule
 (alias runtest)
 (package mosaic)
 (enabled_if
  (and
   (= %{os_type} Unix)
   %{lib-available:lwt.unix}))
 (action
  (setenv
   EXAMPLE
   %{dep:../../examples/26-lwt/main.exe}
   (setenv
    TITLE
    "Lwt timers"
    (setenv
     CANCEL
     1
     (run %{exe:test_examples.exe}))))))

(rule
 (alias runtest)
 (package mosaic)
 (enabled_if
  (= %{os_type} Unix))
 (action
  (setenv
   EXAMPLE
   %{dep:../../examples/27-threads/main.exe}
   (setenv
    TITLE
    "Thread feed"
    (setenv
     CANCEL
     1
     (run %{exe:test_examples.exe}))))))
